{
  "name": "camera-chess",
  "description": "Camera Chess web app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "npm run tsc && biome lint src --error-on-warnings && vite build",
    "lint": "biome lint src --error-on-warnings",
    "tsc": "tsc && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "@litertjs/core": "2.6.0",
    "@reduxjs/toolkit": "^2.12.0",
    "bootstrap": "^5.3.8",
    "chessops": "^0.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "gh-pages": "^6.1.1",
    "npm-check-updates": "^23.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
