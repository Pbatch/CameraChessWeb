{
  "name": "camera-chess",
  "description": "Camera Chess web app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "npm test && npm run tsc && biome lint src --error-on-warnings && vite build",
    "lint": "biome lint src --error-on-warnings",
    "tsc": "tsc && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:layout": "vitest run --project layout",
    "test:watch": "vitest"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@litertjs/core": "2.6.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "chessops": "^0.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@lichess-org/types": "^2.0.176",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^5.0.5",
    "npm-check-updates": "^23.1.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
